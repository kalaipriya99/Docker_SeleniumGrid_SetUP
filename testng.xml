<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SeleniumGridSuite" parallel="tests" thread-count="2">
    
    <test name="GoogleTest-Chrome">
        <parameter name="platformName" value="chrome"/>
        <classes>
            <class name="tests.GoogleTest"/>
        </classes>
    </test>

    <test name="GoogleTest-Firefox">
        <parameter name="platformName" value="firefox"/>
        <classes>
            <class name="tests.GoogleTest"/>
        </classes>
    </test>

</suite>
